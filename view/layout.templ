package view

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - pmux</title>
		<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		<script src="https://cdn.tailwindcss.com"></script>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css"/>
	</head>
	<body class="bg-gray-900 text-gray-100 min-h-screen">
		<nav class="bg-gray-800 border-b border-gray-700 px-4 py-3">
			<div class="flex items-center justify-between max-w-6xl mx-auto">
				<a href="/" class="text-xl font-bold text-green-400">pmux</a>
				<div class="flex gap-4">
					<a href="/" class="hover:text-green-400">Sessions</a>
					<a href="/terminal" class="hover:text-green-400">Terminal</a>
				</div>
			</div>
		</nav>
		<main class="max-w-6xl mx-auto p-4">
			{ children... }
		</main>
	</body>
	</html>
}
